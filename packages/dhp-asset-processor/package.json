{
  "name": "@dai-hai-phat/asset-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/gallery-builder.js",
  "bin": {
    "dhp-assets": "./dist/gallery-builder.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "process": "npm run build --silent && node dist/gallery-builder.js --root ../..",
    "test": "npm run build --silent && node --test tests/*.test.mjs",
    "watch": "npm run build --silent && node dist/gallery-builder.js --root ../.. --watch"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
