GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloud-only AI router. Optional providers must expose an OpenAI-compatible
# /chat/completions endpoint over HTTPS. Keep all API keys server-side.
# Example (single line JSON):
# DHP_AI_CLOUD_PROVIDERS_JSON=[{"id":"provider-id","protocol":"openai-chat","baseUrl":"https://api.example.com/v1/","apiKeyEnv":"PROVIDER_API_KEY","models":[{"id":"free-model-id","tier":"free","priority":10}]}]
DHP_AI_CLOUD_PROVIDERS_JSON=

# Optional trusted model catalog published by the DHP Control Plane/model-intelligence
# layer. Newly listed models are eligible automatically only when their provider
# adapter and API key are already configured above. HTTPS only.
DHP_AI_MODEL_CATALOG_URL=
DHP_AI_MODEL_CATALOG_TOKEN=

# Paid models remain disabled unless this explicit server-side switch is enabled.
DHP_AI_ALLOW_PAID=false

# Required for server-side phone/Zalo number validation. Without this key,
# contact intake and handoff fail closed instead of silently treating a
# format-only number as externally checked.
APILAYER_API_KEY=

# Durable server-only customer inquiry store and AI analysis memory. Keep the
# service-role key private; never expose it as NEXT_PUBLIC_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional downstream CRM/automation sync. A validated inquiry can be accepted by
# the durable Supabase store even when the external CRM webhook is unavailable.
CRM_WEBHOOK_URL=https://crm.example.com/webhooks/dai-hai-phat
CRM_WEBHOOK_TOKEN=
AUTOMATION_WEBHOOK_URL=https://automation.example.com/webhooks/lead-received
AUTOMATION_WEBHOOK_TOKEN=

# Shared bearer token for authenticated ecosystem service-to-service APIs.
# Configure the same long random value for Website, Publishing Bot, Telegram Control,
# and Monitoring callers. Server-side only; never expose as NEXT_PUBLIC_*.
ECOSYSTEM_SERVICE_API_KEY=replace-with-a-long-random-service-token

# Optional public URL override for the standalone Godot Web export.
# Leave empty to use the same-origin build at /godot/gate-configurator/index.html.
NEXT_PUBLIC_GODOT_GATE_CONFIGURATOR_URL=

# Shared /admin Basic Auth (server-side only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# DHP Agent Control Plane (server-side only; never expose these as NEXT_PUBLIC_* variables)
DHP_CONTROL_PLANE_URL=http://127.0.0.1:8787
DHP_CONTROL_PLANE_KEY_ID=web
DHP_CONTROL_PLANE_SECRET=replace-with-the-same-secret-configured-in-control-plane
DHP_CONTROL_PLANE_TIMEOUT_MS=30000

# Optional server-side override. On the Supabase deployment the web derives the
# sibling dhp-capability-gateway URL from DHP_CONTROL_PLANE_URL automatically.
DHP_CAPABILITY_GATEWAY_URL=
