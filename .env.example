GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CRM_WEBHOOK_URL=https://crm.example.com/webhooks/dai-hai-phat
CRM_WEBHOOK_TOKEN=
AUTOMATION_WEBHOOK_URL=https://automation.example.com/webhooks/lead-received
AUTOMATION_WEBHOOK_TOKEN=

# Optional public URL override for the standalone Godot Web export.
# Leave empty to use the same-origin build at /godot/gate-configurator/index.html.
NEXT_PUBLIC_GODOT_GATE_CONFIGURATOR_URL=

# Shared /admin Basic Auth (server-side only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# DHP Agent Control Plane (server-side only; never expose these as NEXT_PUBLIC_* variables)
DHP_CONTROL_PLANE_URL=http://127.0.0.1:8787
DHP_CONTROL_PLANE_KEY_ID=web
DHP_CONTROL_PLANE_SECRET=replace-with-the-same-secret-configured-in-control-plane
DHP_CONTROL_PLANE_TIMEOUT_MS=30000

# Optional server-side override. On the Supabase deployment the web derives the
# sibling dhp-capability-gateway URL from DHP_CONTROL_PLANE_URL automatically.
DHP_CAPABILITY_GATEWAY_URL=
