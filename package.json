{
  "name": "dai-hai-phat-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-built-css.mjs",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run build",
    "architecture:check": "sentrux check .",
    "assets:build": "npm --prefix packages/dhp-asset-processor run process",
    "security:strix": "node scripts/run-strix.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev:vinext": "vinext dev",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start",
    "preview:cloudflare": "npm run build:vinext && wrangler dev",
    "deploy:cloudflare": "vinext-cloudflare deploy",
    "cf:typegen": "wrangler types",
    "cloudflare:bundle-check": "wrangler deploy --outdir .wrangler-bundle --dry-run"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.44",
    "ai": "7.0.66",
    "lucide-react": "^0.400.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0",
    "@cloudflare/vite-plugin": "1.62.4",
    "@vinext/cloudflare": "1.0.0-beta.10",
    "vite": "8.3.1",
    "vinext": "1.0.0-beta.12",
    "wrangler": "4.145.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "react-server-dom-webpack": "19.2.8"
  },
  "overrides": {
    "brace-expansion": "1.1.21",
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.5"
    }
  },
  "type": "module"
}
