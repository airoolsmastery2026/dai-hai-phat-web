{
  "name": "dai-hai-phat-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-built-css.mjs",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run build",
    "architecture:check": "sentrux check .",
    "assets:build": "npm --prefix packages/dhp-asset-processor run process",
    "security:strix": "node scripts/run-strix.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.44",
    "ai": "7.0.66",
    "lucide-react": "^0.400.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
